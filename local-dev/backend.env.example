# Local development environment template — KIUT Digital Club (Flask backend)
#
# Copy this to  current-website/DIgital-Club/.env  and replace SECRET_KEY with a
# locally generated value:
#
#   local-dev/.tools/Scripts/python.exe -c "import secrets;print(secrets.token_hex(32))"
#
# current-website/DIgital-Club/.env is gitignored by the backend repository.
# NEVER commit it, and NEVER copy production values into it.
#
# The values below are local-only. The Turnstile keys are Cloudflare's public
# test keys (they always pass and only validate dummy tokens); they are not
# credentials and must never be used in production.

# --- Core -------------------------------------------------------------------
# Marks this as a local configuration only. create_app() refuses to start with an
# empty SECRET_KEY unless FLASK_ENV is development/local (Phase 5, fail-closed).
FLASK_ENV=development
SECRET_KEY=<generate-a-local-value>
PORT=5051

# --- Database ---------------------------------------------------------------
# Relative SQLite paths resolve against the Flask instance folder
# (current-website/DIgital-Club/instance/), which is gitignored.
# Schema-only local database; no production data is ever copied here.
DATABASE_URL=sqlite:///dev_local.db

# --- Session / cookies -------------------------------------------------------
SESSION_LIFETIME_DAYS=30
REMEMBER_LIFETIME_DAYS=30
# Local development is plain HTTP on 127.0.0.1, so a Secure cookie would never
# be sent back. Production must keep this at 1 (the application default).
REMEMBER_COOKIE_SECURE=0
# Session cookie Secure flag. Unset means "Secure outside development, not Secure
# locally"; set explicitly only to override.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# --- JSON API (/api/v1) ------------------------------------------------------
# Process-local rate limiting. Limits live in app/__init__.py (API_RATE_LIMITS);
# see INTEGRATION_AUDIT.md R19 before using more than one worker.
RATELIMIT_ENABLED=1
# Extra origins allowed to send state-changing requests to this app, comma
# separated. Same-host requests always pass, and the Vite dev proxy keeps the
# browser on one origin, so this stays empty locally.
APP_ALLOWED_ORIGINS=

# --- Turnstile (Cloudflare test keys) ---------------------------------------
# Visible widget that always passes + matching secret that always validates.
# Production uses real keys from Cloudflare and never these values.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Application behaviour ---------------------------------------------------
APP_TIMEZONE=Africa/Nairobi
APP_UTC_OFFSET_HOURS=3
PREFERRED_URL_SCHEME=http
# Leave SERVER_NAME unset locally: setting it makes Flask answer 404 for any
# Host header that does not match it.
# SERVER_NAME=

# --- Optional integrations (stay disabled/empty locally) ---------------------
# Redis, e-mail and SMS are not required to run the application. Quiz reminders
# are disabled so a local request never triggers background work.
REDIS_URL=
QUIZ_REMINDER_RUN_ON_REQUEST=0
QUIZ_REMINDER_INTERVAL_SECONDS=30
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
BEEM_API_KEY=
BEEM_SECRET_KEY=
